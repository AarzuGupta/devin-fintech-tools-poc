# SQLite database file (relative to prisma/schema.prisma). connection_limit=1 serializes
# writes in-process; larger Prisma pools can stall concurrent SQLite transactions on small hosts.
DATABASE_URL="file:./dev.db?connection_limit=1"
# Secret used to HMAC-sign the demo session cookie. Use a long random value.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Refunds upstream (local mock finance API served by this app). The token is a
# local placeholder, not a credential. Point these at a real service to swap upstreams.
# If REFUNDS_API_BASE_URL is unset, the app calls its own mock on http://127.0.0.1:$PORT.
REFUNDS_API_BASE_URL="http://127.0.0.1:3000/api/mock-finance/v1"
REFUNDS_API_TOKEN="local-mock-token-not-a-secret"
